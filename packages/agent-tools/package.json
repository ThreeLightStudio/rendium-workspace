{
  "name": "@rendium/agent-tools",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "Rendium Contributors",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "rendium-agent-tools": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "render": "node ./dist/cli.js"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "js-yaml": "^4.1.1",
    "lodash-es": "^4.18.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.19.15",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
  }
}
