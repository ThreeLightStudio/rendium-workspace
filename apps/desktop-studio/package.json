{
  "name": "desktop-studio",
  "productName": "Rendium Desktop Studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Electron app shell showcasing @rendium/engine (declarative audio-reactive video graphics).",
  "main": "./out/main/index.js",
  "author": "Rendium Contributors",
  "scripts": {
    "agent": "pnpm --dir ../.. agent",
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "check": "biome check --write ./src",
    "check:data-f": "node ../../scripts/check-data-f.cjs --all",
    "prestorybook": "panda codegen",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:dev": "concurrently -k -n PANDA,STORY -c cyan,magenta \"panda codegen --watch\" \"storybook dev -p 6006\"",
    "predev": "panda codegen",
    "pretypecheck": "panda codegen",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "panda codegen && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:icons": "electron-icon-builder --input=./src/renderer/src/assets/icon-source.png --output=build --flatten",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@rendium/engine": "workspace:*",
    "lucide-react": "^1.7.0",
    "mp4-muxer": "^5.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@pandacss/dev": "^1.10.0",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "storybook": "^8.6.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
